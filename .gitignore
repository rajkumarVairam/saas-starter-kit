# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# bun lock
bun.lock

# testing
/coverage
/e2e/.auth
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts (generated by prebuild scripts)
public/r/themes
public/r/v0

# lock files from other package managers (this project uses pnpm)
package-lock.json
yarn.lock

# OS files
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Claude Code
.claude/
