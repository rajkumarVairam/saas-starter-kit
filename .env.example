# ============================================================
# STEP 1 — BASE URL
# Set this to your local dev URL (or your production domain).
# ============================================================
BASE_URL="http://localhost:3000"

# ============================================================
# STEP 2 — DATABASE (Required)
# Set up a free PostgreSQL database on Neon: https://console.neon.tech/
# The project uses the Neon serverless driver adapter.
# After creating a project, copy the connection string here.
# Then run: pnpm db:push
# ============================================================
DATABASE_URL="postgresql://neondb_owner:[YOUR_NEON_PASSWORD]@[YOUR_NEON_HOST]/neondb?sslmode=require"

# ============================================================
# STEP 3 — AUTH (Required)
# Generate a secret: https://generate-secret.vercel.app/32
# Then create OAuth apps for GitHub and/or Google.
# Docs: https://www.better-auth.com/docs/installation#set-environment-variables
# ============================================================
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET"

# GitHub OAuth App: https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Google OAuth Credentials: https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ============================================================
# STEP 4 — BILLING / SUBSCRIPTIONS (Required for paid plans)
# Create a Polar account and product: https://polar.sh/
# Add the access token and webhook secret from your Polar dashboard.
# Use the same product ID for both variables below.
# ============================================================
POLAR_ACCESS_TOKEN="YOUR_POLAR_ACCESS_TOKEN"
POLAR_WEBHOOK_SECRET="YOUR_POLAR_WEBHOOK_SECRET"

# Server-only — used for subscription checks (never expose to client)
SAASKIT_PRO_PRODUCT_ID="YOUR_POLAR_PRO_PRODUCT_ID"
# Client-side display only (pricing UI)
NEXT_PUBLIC_SAASKIT_PRO_PRODUCT_ID="YOUR_POLAR_PRO_PRODUCT_ID"

# ============================================================
# STEP 5 — AI PROVIDER (Required for AI features)
# Set AI_PROVIDER to one of: google | openai | anthropic | groq
# Then set only the API key for the provider you chose.
# ============================================================
AI_PROVIDER="google"

# Google Gemini (default): https://aistudio.google.com/apikey
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Anthropic: https://console.anthropic.com/settings/api-keys
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Groq: https://console.groq.com/keys
# GROQ_API_KEY="YOUR_GROQ_API_KEY"

# ============================================================
# STEP 6 — GOOGLE FONTS (Required for font picker)
# Get a key: https://developers.google.com/fonts/docs/developer_api
# ============================================================
GOOGLE_FONTS_API_KEY="YOUR_GOOGLE_FONTS_API_KEY"

# ============================================================
# STEP 7 — RATE LIMITING (Required in production)
# Create a Vercel KV store or Upstash Redis instance.
# Vercel KV: https://vercel.com/docs/storage/vercel-kv
# Upstash: https://upstash.com/
# ============================================================
KV_REST_API_URL="YOUR_KV_REST_API_URL"
KV_REST_API_TOKEN="YOUR_KV_REST_API_TOKEN"

# ============================================================
# STEP 8 — EMAIL (Optional)
# Transactional emails (welcome, subscription) are skipped if not set.
# Get a Resend API key: https://resend.com/api-keys
# ============================================================
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="LaunchKit <hello@launchkit.dev>"

# ============================================================
# STEP 9 — ANALYTICS (Optional)
# PostHog analytics — disabled if not set.
# Get keys: https://posthog.com/
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY="YOUR_POSTHOG_KEY"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ============================================================
# STEP 10 — ADMIN ACCESS (Optional)
# Comma-separated list of emails that can access /admin.
# Leave blank to disable admin panel entirely.
# ============================================================
ADMIN_EMAILS="you@example.com"

# ============================================================
# STEP 11 — ERROR MONITORING (Optional)
# Error monitoring is disabled if not set.
# Set up a Sentry project: https://sentry.io/
# ============================================================
NEXT_PUBLIC_SENTRY_DSN="YOUR_SENTRY_DSN"
SENTRY_ORG="YOUR_SENTRY_ORG"
SENTRY_PROJECT="YOUR_SENTRY_PROJECT"
